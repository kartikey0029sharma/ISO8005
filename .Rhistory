packages <- c("readxl", "tidyverse", "lubridate", "janitor", "scales",
"knitr", "kableExtra", "patchwork", "broom", "gt", "here")
for (pkg in packages) {
if (!require(pkg, character.only = TRUE)) {
install.packages(pkg)
}
}
source("scripts/RUN_ALL.R")
source("scripts/RUN_ALL.R")
source("scripts/RUN_ALL.R")
source("scripts/RUN_ALL.R")
packages <- c("readxl", "tidyverse", "lubridate", "janitor", "scales",
"knitr", "kableExtra", "patchwork", "broom", "gt", "here")
for (pkg in packages) {
if (!require(pkg, character.only = TRUE)) {
install.packages(pkg)
}
