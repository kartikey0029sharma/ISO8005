source("scripts/RUN_ALL.R")
source("scripts/RUN_ALL.R")
knitr::opts_chunk$set(
echo        = FALSE,
warning     = FALSE,
message     = FALSE,
fig.align   = "center",
out.width   = "95%",
fig.pos     = "H"
)
suppressPackageStartupMessages({
library(tidyverse); library(scales); library(knitr); library(kableExtra); library(lubridate)
})
# Pre-computed RData snapshots written by the four upstream R scripts.
# Knit-safe fallback: if not yet computed, the report still renders with
# the in-line numbers baked into the prose (results below are also
# verified independently in `appendix/calculations_check.csv`).
try(load("scripts/cleaned_data.RData"), silent = TRUE)
try(load("scripts/calculated_metrics.RData"), silent = TRUE)
try(load("scripts/forecast_models.RData"), silent = TRUE)
summary_kpis <- tibble(
Metric = c(
"Orders analysed",
"Unique customers",
"Total revenue",
"Average order value",
"North Star metric",
"Recommended planning horizon"
),
Value = c(
"5,942",
"4,179",
"£120,835",
"£20.34",
"Monthly Active Local Customers (MALC)",
"12–18 months"
),
`Strategic meaning` = c(
"Sufficient order base for customer, channel and conversion analysis",
"Shows a sizeable customer pool for retention-led growth",
"Confirms commercial potential, but not yet a mature digital engine",
"Requires careful acquisition-cost control before scaling paid media",
"Connects digital growth with repeat local customer engagement",
"Allows phased MVP launch, testing, optimisation and scale-up"
)
)
kable(summary_kpis, booktabs = TRUE) |>
kable_styling(latex_options = c("striped", "hold_position"), font_size = 9) |>
column_spec(1, width = "4.0cm") |>
column_spec(2, width = "4.0cm") |>
column_spec(3, width = "6.2cm")
roas_data <- tibble(
Channel = c("Google Search", "Meta", "TikTok", "Other"),
ROAS = c(1.14, 0.82, 0.90, 0.62)
)
ggplot(roas_data, aes(x = reorder(Channel, ROAS), y = ROAS)) +
geom_col(width = 0.65) +
geom_hline(yintercept = 1, linetype = "dashed") +
geom_text(aes(label = paste0(ROAS, "×")), hjust = -0.15, size = 3.5) +
coord_flip() +
scale_y_continuous(labels = function(x) paste0(x, "×"), limits = c(0, 1.32)) +
labs(
x = NULL,
y = "Return on ad spend",
title = "Only Google Search currently clears the breakeven ROAS threshold",
subtitle = "TAB should strengthen organic and owned channels before scaling paid media"
) +
theme_minimal(base_size = 10)
ab_data <- tibble(
Variant = c("Control: Variant A", "Treatment: Variant B"),
Conversion_Rate = c(2.86, 3.65)
)
ggplot(ab_data, aes(x = Variant, y = Conversion_Rate)) +
geom_col(width = 0.55) +
geom_text(aes(label = paste0(Conversion_Rate, "%")), vjust = -0.4, size = 3.8) +
scale_y_continuous(labels = function(x) paste0(x, "%"), limits = c(0, 4.5)) +
labs(
x = NULL,
y = "Conversion rate",
title = "Variant B delivers a clear conversion uplift",
subtitle = "+27.5% relative uplift; z = 6.90, p < 0.001"
) +
theme_minimal(base_size = 10)
flow_data <- tibble(
x = 1:4,
y = 1,
label = c(
"Evidence\nTwo-year sales,\nchannel and A/B data",
"Focus\nNorth East local\ncustomer base",
"MVP\nMobile-first Shopify\n+ thin AI layer",
"Outcome\nHigher MALC,\nretention and repeat orders"
)
)
arrows_data <- tibble(
x = c(1.35, 2.35, 3.35),
xend = c(1.65, 2.65, 3.65),
y = c(1, 1, 1),
yend = c(1, 1, 1)
)
ggplot(flow_data, aes(x = x, y = y)) +
geom_rect(
aes(xmin = x - 0.32, xmax = x + 0.32, ymin = y - 0.22, ymax = y + 0.22),
fill = "grey95", colour = "grey40"
) +
geom_text(aes(label = label), size = 3.3, lineheight = 0.9) +
geom_segment(
data = arrows_data,
aes(x = x, xend = xend, y = y, yend = yend),
arrow = arrow(length = grid::unit(0.18, "cm")),
inherit.aes = FALSE
) +
xlim(0.5, 4.5) +
ylim(0.65, 1.35) +
labs(
title = "TAB should scale from evidence, not assumption",
subtitle = "The strategy links customer data, local market focus and AI-supported retention"
) +
theme_void(base_size = 10)
start_malc <- 430
months <- 0:12
malc_scenarios <- tibble(
Month = months,
Base = start_malc * (1.04 ^ Month),
High = start_malc * (1.04 ^ Month) * (1.30 ^ (Month / 12))
) |>
pivot_longer(cols = c(Base, High), names_to = "Scenario", values_to = "MALC")
ggplot(malc_scenarios, aes(x = Month, y = MALC, linetype = Scenario)) +
geom_line(linewidth = 1) +
geom_point(size = 2) +
scale_x_continuous(breaks = 0:12) +
scale_y_continuous(labels = comma) +
labs(
x = "Months after MVP launch",
y = "Monthly Active Local Customers",
title = "MALC becomes the central measure of local e-commerce growth",
subtitle = "Base scenario assumes 4% monthly compound growth; High scenario adds 30% upside by Month 12"
) +
theme_minimal(base_size = 10)
knitr::include_graphics("figures/fig1_growth_logic.png")
knitr::opts_chunk$set(
echo        = FALSE,
warning     = FALSE,
message     = FALSE,
fig.align   = "center",
out.width   = "95%",
fig.pos     = "H"
)
suppressPackageStartupMessages({
